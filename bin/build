#!/bin/sh
set -e

# Create .env file if it doesn't exist
if [ ! -f ".env" ]; then
    echo "Creating .env from .env.example..."
    cp .env.example .env

    # If running on Railway, replace placeholders with environment variables
    if [ ! -z "$RAILWAY_ENVIRONMENT_NAME" ]; then
        echo "Detected Railway environment, configuring for Railway..."

        # Update database configuration from Railway environment variables
        if [ ! -z "$DATABASE_HOST" ]; then
            sed -i "s/DB_HOST=.*/DB_HOST=$DATABASE_HOST/" .env
        fi
        if [ ! -z "$DATABASE_PORT" ]; then
            sed -i "s/DB_PORT=.*/DB_PORT=$DATABASE_PORT/" .env
        fi
        if [ ! -z "$DATABASE_NAME" ]; then
            sed -i "s/DB_DATABASE=.*/DB_DATABASE=$DATABASE_NAME/" .env
        fi
        if [ ! -z "$DATABASE_USER" ]; then
            sed -i "s/DB_USERNAME=.*/DB_USERNAME=$DATABASE_USER/" .env
        fi
        if [ ! -z "$DATABASE_PASSWORD" ]; then
            sed -i "s/DB_PASSWORD=.*/DB_PASSWORD=$DATABASE_PASSWORD/" .env
        fi

        # Ensure correct database driver
        sed -i "s/DB_CONNECTION=.*/DB_CONNECTION=mysql/" .env

        # Set production URL
        if [ ! -z "$RAILWAY_STATIC_URL" ]; then
            sed -i "s|APP_URL=.*|APP_URL=$RAILWAY_STATIC_URL|" .env
        fi
    fi
fi

# Ensure storage directories exist
mkdir -p storage/framework/views
mkdir -p storage/framework/cache
mkdir -p storage/logs
mkdir -p database

# Install composer dependencies
composer install --no-dev --optimize-autoloader

# Generate app key if not set in .env
if ! grep -q "^APP_KEY=base64:" .env; then
    echo "Generating APP_KEY..."
    php artisan key:generate --force
fi

# Clear config cache from previous builds
php artisan config:clear

# Create storage symlink for public access to uploaded files
php artisan storage:link --force || true

# Build frontend assets
echo "Building frontend assets..."
npm ci --omit=dev
npm run build

echo "Build completed successfully!"

