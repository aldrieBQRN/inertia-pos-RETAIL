# 1. Disable directory index listing
Options -Indexes

# 2. Block direct web access to all hidden dotfiles (e.g. .env, .git)
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>

# 3. Block direct web access to sensitive system files & database/log extensions
<FilesMatch "(^#.*#|\.(bak|config|dist|fla|inc|ini|log|psd|sh|sql|sw[op]|sqlite)|composer\.json|composer\.lock|package\.json|package-lock\.json|artisan|phpunit\.xml|env\.php|custom_env\.php)$">
    Order allow,deny
    Deny from all
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 4. Block direct web access to internal Laravel directories
    RewriteRule ^(inertia-pos-core|core|app|bootstrap|config|database|resources|routes|vendor)(/.*)?$ - [F,L]

    # 5. Serve real static files and directories directly (build/*, images/*, favicon, manifest, etc.)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # 6. Route all other application traffic through index.php
    RewriteRule ^ index.php [L]
</IfModule>
