# 1. Disable directory index listing
Options -Indexes

# 2. Block direct web access to all hidden dotfiles (e.g. .env, .git)
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>

# 3. Block direct web access to sensitive system files & database/log extensions
<FilesMatch "(^#.*#|\.(bak|config|dist|fla|inc|ini|log|psd|sh|sql|sw[op]|sqlite)|composer\.json|composer\.lock|package\.json|package-lock\.json|artisan|phpunit\.xml|env\.php|custom_env\.php)$">
    Order allow,deny
    Deny from all
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 4. Block direct web access to internal Laravel directories
    RewriteRule ^(inertia-pos-core|core|app|bootstrap|config|database|resources|routes|vendor|storage/framework|storage/logs)(/.*)?$ - [F,L]

    # 5. Route build assets to public/build
    RewriteRule ^build/(.*)$ public/build/$1 [L]

    # 6. Route images to public/images
    RewriteRule ^images/(.*)$ public/images/$1 [L]

    # 7. Route public storage files
    RewriteRule ^storage/(.*)$ storage/app/public/$1 [L]

    # 8. Route common public files
    RewriteRule ^favicon\.ico$ public/favicon.ico [L]
    RewriteRule ^favicon\.png$ public/favicon.png [L]
    RewriteRule ^robots\.txt$ public/robots.txt [L]
    RewriteRule ^manifest\.webmanifest$ public/manifest.webmanifest [L]
    RewriteRule ^service-worker\.js$ public/service-worker.js [L]

    # 9. Route everything else to root index.php
    RewriteRule ^ index.php [L]
</IfModule>
