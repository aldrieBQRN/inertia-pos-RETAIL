# 1. Disable directory index listing
Options -Indexes

# 2. Configure Proper MIME Types for PWA, Images, and Webp
<IfModule mod_mime.c>
    AddType application/manifest+json .webmanifest
    AddType application/json .json
    AddType image/webp .webp
    AddType image/svg+xml .svg
</IfModule>

# 3. Block direct web access to all hidden dotfiles (e.g. .env, .git)
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>

# 4. Block direct web access to sensitive system files & database/log extensions
<FilesMatch "(^#.*#|\.(bak|config|dist|fla|inc|ini|log|psd|sh|sql|sw[op]|sqlite)|composer\.json|composer\.lock|package\.json|package-lock\.json|artisan|phpunit\.xml|env\.php|custom_env\.php)$">
    Order allow,deny
    Deny from all
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 5. Block direct web access to internal Laravel directories
    RewriteRule ^(inertia-pos-core|core|app|bootstrap|config|database|resources|routes|vendor)(/.*)?$ - [F,L]

    # 6. Route all /storage/... requests directly to Laravel index.php (to stream from inertia-pos-core/storage/app/public)
    RewriteRule ^storage/(.*)$ index.php [L]

    # 7. Serve real static files directly (e.g. build/*, images/*, favicon, manifest.webmanifest, service-worker.js)
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # 8. Route all other application traffic through index.php
    RewriteRule ^ index.php [L]
</IfModule>
