APP_NAME="Inertia POS System"
APP_ENV=production
APP_KEY=base64:M7T0Ylcc4NQ4VD+Yk/HnNxFSE4Bj7SCmUXAyR68Sz30=
APP_DEBUG=false
APP_URL=https://your-railway-app.up.railway.app

# Database Configuration - Railway MySQL (auto-provisioned)
# Set these in Railway Dashboard -> Variables
DB_CONNECTION=mysql
DB_HOST=${DATABASE_HOST}
DB_PORT=${DATABASE_PORT}
DB_DATABASE=${DATABASE_NAME}
DB_USERNAME=${DATABASE_USER}
DB_PASSWORD=${DATABASE_PASSWORD}

# Mail Configuration - Gmail SMTP
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=appmessage.notify@gmail.com
MAIL_PASSWORD=cloeukcxtctkxcoe
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="inertia.pos.system@gmail.com"
MAIL_FROM_NAME="Inertia POS System"

# Queue Configuration - Database queue for background processing
QUEUE_CONNECTION=database
DB_QUEUE_TABLE=jobs
DB_QUEUE=default

# Cache Configuration
CACHE_DRIVER=database
CACHE_TABLE=cache

# Session Configuration
SESSION_DRIVER=database
SESSION_TABLE=sessions

# Log Configuration
LOG_CHANNEL=single
LOG_LEVEL=info
