APP_NAME="Smart Retail POS System"
APP_ENV=production
APP_KEY=base64:YOUR_GENERATED_KEY_HERE
APP_DEBUG=false
APP_URL=https://your-domain.infinityfree.app

# Database Configuration - InfinityFree (use localhost)
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=infinityfree_dbname
DB_USERNAME=infinityfree_username
DB_PASSWORD=your_mysql_password

# Mail Configuration - Gmail SMTP (recommended)
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="admin@your-domain.infinityfree.app"
MAIL_FROM_NAME="POS System Admin"

# Queue Configuration - Database queue for background processing
QUEUE_CONNECTION=database
DB_QUEUE_CONNECTION=mysql
DB_QUEUE_TABLE=jobs
DB_QUEUE=default

# Session & Cache Configuration
SESSION_DRIVER=cookie
CACHE_DRIVER=file
CACHE_PREFIX=pos_system_

# Broadcasting
BROADCAST_DRIVER=log

# Additional Settings
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# These are optional but recommended
FILESYSTEM_DISK=local
TELESCOPE_ENABLED=false
